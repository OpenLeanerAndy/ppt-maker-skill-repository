{
  "name": "ppt-maker-runtime",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local PptxGenJS fallback runtime for the ppt-maker Agent Skill.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
